<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Metadata membantu browser memahami encoding dan tampilan responsive. -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eventra</title>
    <!-- CDN memuat library dari server eksternal tanpa instalasi lokal. -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css">
    <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
     <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.12.3/dist/JsBarcode.all.min.js"></script>
</head>
<body class="bg-gray-50">
        <!-- `nav` menandai area navigasi utama halaman secara semantik. -->
        <nav class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center py-4">
                <div class="flex items-center">
                    <a href="/" class="flex items-center space-x-3">
                        <span class="text-2xl font-bold text-indigo-600">Eventra</span>
                    </a>
                </div>
                
                <!-- Prefix `md:` di Tailwind berarti style aktif mulai breakpoint medium. -->
                <div class="hidden md:flex items-center space-x-8">
                    <a href="/" class="text-gray-700 hover:text-indigo-600">Home</a>
                    <a href="/events" class="text-gray-700 hover:text-indigo-600">Events</a>

                    <% if(user) { %> 
                    <% if(user.role === 'creator') { %>
                        <a href="/events/create" class="text-gray-700 hover:text-indigo-600">Buat Event</a>
                        <a href="/my-events" class="text-gray-700 hover:text-indigo-600">Event Saya</a>
                    <% } %> 
                         <div class="relative group">
                        <button class="flex items-center text-gray-700 hover:text-indigo-600 space-x-2">
                            <img 
                                src="https://ui-avatars.com/api/?name=<%= user.name %>&background=4f46e5&color=ffffff&rounded=true&size=32&bold=true" 
                                alt="<%= user.name %>" 
                                class="w-8 h-8 rounded-full border-2 border-indigo-100 shadow-sm"
                            >
                            <span><%= user.name %></span>
                            <!-- SVG ini adalah ikon panah dropdown yang digambar dengan path. -->
                            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>
                        <div class="absolute right-0 w-48 bg-white rounded-md shadow-lg py-1 hidden group-hover:block z-50 border border-gray-100">
                            <div class="px-4 py-2 flex items-center space-x-2 border-b border-gray-100">
                                <img 
                                    src="https://ui-avatars.com/api/?name=<%= user.name %>&background=4f46e5&color=ffffff&rounded=true&size=32&bold=true" 
                                    alt="<%= user.name %>" 
                                    class="w-8 h-8 rounded-full"
                                >
                                <div class="text-sm font-medium text-gray-700 truncate">
                                   <%= user.name %>
                                </div>
                            </div>
                            <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-150">
                                <i class="fas fa-user mr-2 text-indigo-500"></i>Profile
                            </a>
                            <a href="/my-orders" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-150">
                                <i class="fas fa-ticket-alt mr-2 text-indigo-500"></i>Pesanan Saya
                            </a>
                            <% if (user.role === 'creator') {  %>
                                <a href="/my-events" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-150">
                                <i class="fas fa-calendar-alt mr-2 text-indigo-500"></i>Event Saya
                            </a>
                            <% } %>
                            
                            <div class="border-t border-gray-100 mt-1 pt-1">
                                <!-- Form POST mengirim aksi logout ke server, bukan sekadar membuka URL. -->
                                <form method="POST" action="/logout" class="w-full">
                                    <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-700 transition-colors duration-150">
                                        <i class="fas fa-sign-out-alt mr-2 text-red-500"></i>Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <% } else {%>
                        <a href="/login" class="text-gray-700 hover:text-indigo-600">Login</a>
                        <a href="/register" class="bg-indigo-600 text-white px-4 py-2 text-gray-700 hover:text-indigo-700 transition-colors duration-200 rounded-lg">Register</a>
                    <% } %>
                    <!-- `group-hover:block` menampilkan menu saat parent `.group` di-hover. -->
               
                </div>
            </div>
        </div>
    </nav>
</body>
</html>