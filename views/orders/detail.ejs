<%- include('../../partials/header') %>
<body>

<div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Detail Pesanan #<%= order.id %></h1>
            <p class="text-gray-600 mt-2">
                Dipesan pada 
                <%= new Date(order.created_at).toLocaleDateString('id-ID', {
                    weekday: 'long',
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                }) %> 
                
            </p>
        </div>
        <div class="mt-4 md:mt-0">
            <span class="px-4 py-2 rounded-full text-sm font-semibold  <%= order.status === 'paid' ? 'bg-green-100 text-gren-800' :
                                    order.status === 'pending' ? 'bg-yellow-100 text-yellow-800' :
                                    order.status === 'expired' ? 'bg-red-100 text-red-800' :
                                    'bg-gray-100 text-gray-800' %>">
                                <%= order.status === 'paid' ? 'Lunas':
                                    order.status === 'pending' ? 'Menunggu Pembayaran':
                                    order.status === 'expired' ? 'Kadaluarsa':
                                    order.status === 'cancelled' ? 'Dibatalkan': order.status %>
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Event Information -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <div class="p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">Informasi Event</h2>
                    
                    <div class="flex flex-col md:flex-row md:items-start gap-6">
                        <% if(order.Event.image_path) { %>
                        <img src="<%= order.Event.image_path && !order.Event.image_path.startsWith('/') && !/^https?:\/\//i.test(order.Event.image_path) ? '/' + order.Event.image_path : order.Event.image_path %>" 
                             alt="<%= order.Event.title %>" 
                             class="w-full md:w-48 h-48 object-cover rounded-lg">
                        <% } else {%>
                            <div class="w-full md:w-48 h-48 bg-gray-200 rounded-lg flex items-center justify-center">
                                <span class="text-gray-500">No Image</span>
                            </div>
                        <% } %>
                        <div class="flex-1">
                            <h3 class="text-lg font-bold text-gray-900 mb-2"><%= order.Event.title %></h3>
                            <p class="text-gray-600 mb-4 line-clamp-3">Konser musik terbesar tahun ini dengan artis-artis ternama. Acara yang tak boleh dilewatkan bagi pecinta musik!</p>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <p class="text-sm text-gray-500">Tanggal & Waktu</p>
                                    <p class="font-semibold">
                                       <%= new Date(order.Event.event_date).toLocaleDateString('id-ID', {
                                        weekday: 'long',
                                        day: 'numeric',
                                        month: 'short',
                                        year: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                        }) %> 
                                        <br>
                                    </p>
                                </div>
                                
                                <div>
                                    <p class="text-sm text-gray-500">Lokasi</p>
                                    <p class="font-semibold"><%= order.Event.venue %></p>
                                    <p class="text-gray-600 text-sm"><%= order.Event.city %></p>
                                </div>
                                
                                <div>
                                    <p class="text-sm text-gray-500">Kategori</p>
                                    <p class="font-semibold">
                                        <%= order.Event.Category.name %></p>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Ringkasan Pesanan</h2>
                
                <div class="space-y-4">
                    <div class="flex justify-between items-center pb-4 border-b">
                        <div>
                            <p class="font-semibold">Jumlah Tiket</p>
                            <p class="text-gray-600 text-sm"><%= order.quantity %> Tiket</p>
                        </div>
                        <div class="text-right">
                            <p class="font-semibold">Harga per Tiket</p>
                            <p class="text-gray-600">
                                Rp <%= Number(order.Event.price).toLocaleString('id-ID') %>
                            </p>
                        </div>
                    </div>
                    
                    <div class="flex justify-between items-center pt-4">
                        <p class="text-lg font-bold text-gray-900">Total Pembayaran</p>
                        <p class="text-2xl font-bold text-green-600">
                            Rp <%= Number(order.total_amount).toLocaleString('id-ID') %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Tickets -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Tiket Anda (<%= order.Tickets.length %>)</h2>
                
                <div class="space-y-6">
                    <!-- Ticket 1 -->
                     <% order.Tickets.forEach((ticket, index) => { %>
                    <div class="border border-gray-200 rounded-lg p-6">
                        <!-- Ticket Header -->
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900">Tiket #<%= index + 1 %></h3>
                                <p class="text-gray-600 text-sm">
                                    Kode: <code class="bg-gray-100 px-2 py-1 rounded font-mono">
                                       <%= ticket.ticket_code %>
                                    </code>
                                </p>
                            </div>
                            
                            <div class="mt-2 md:mt-0">
                                <span class="px-3 py-1 rounded-full text-sm font-semibold <%= ticket.is_attended ? 'bg-green-100 text-green-600' :'bg-yellow-100 text-yellow-600' %>">    
                                    <%= ticket.is_attended ? 'Sudah Check-in' : 'Belum Check-in' %>
                                </span>
                            </div>
                        </div>

                        <!-- Attendee Information -->
                        <div class="mb-6">
                            <h4 class="text-sm font-semibold text-gray-700 mb-3">Informasi Attendee</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <p class="text-sm text-gray-500">Nama</p>
                                    <p class="font-semibold"><%= ticket.attendee_name %></p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-500">Email</p>
                                    <p class="font-semibold"><%= ticket.attendee_email %></p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-500">Telepon</p>
                                    <p class="font-semibold"><%= ticket.attendee_phone %></p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-500">Dibuat</p>
                                    <p class="font-semibold">
                                        <%= new Date(ticket.created_at).toLocaleDateString('id-ID', {
                                        weekday: 'long',
                                        day: 'numeric',
                                        month: 'short',
                                        year: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                        }) %> 
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                         <div class="flex flex-wrap gap-3 pt-6 border-t border-gray-200">
                         <% if(order.status === 'paid' && order.Tickets.length > 0) { %>   
                            <button onclick="window.print()" 
                                    class="bg-green-500 text-white px-4 py-2 rounded-lg font-semibold hover:bg-green-600 font-semibold">
                                <i class="fas fa-print mr-2"></i> Print Tiket
                            </button>
                         <% } %>
                        
                          <% if(!ticket.is_attended) { %> 
                            <button onclick="showTicketCode('<%= ticket.ticket_code %>')"
                                    class="bg-purple-500 text-white px-4 py-2 rounded-lg hover:bg-purple-600 text-sm font-semibold">
                                <i class="fas fa-eye mr-2"></i>Tampilkan Kode
                            </button>
                         <% } %>
                        </div>
                     
                    </div>
                    <%}) %>
                    


                </div>
            </div>
        </div>
        

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Order Actions -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Aksi</h3>
                <div class="space-y-3">
                    <a href="/events/<%= order.Event.id %>" 
                       class="block w-full bg-blue-50 text-blue-600 text-center py-3 rounded-lg font-semibold hover:bg-blue-100 transition duration-300">
                        <i class="fas fa-calendar-alt mr-2"></i> Lihat Event
                    </a>
                    
                    <a href="/events" 
                       class="block w-full bg-green-50 text-green-600 text-center py-3 rounded-lg font-semibold hover:bg-green-100 transition duration-300">
                        <i class="fas fa-search mr-2"></i> Cari Event Lain
                    </a>
                </div>
            </div>

            <!-- Order Information -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Informasi Pesanan</h3>
                <div class="space-y-3">
                    <div>
                        <p class="text-sm text-gray-500">Order ID</p>
                        <p class="font-semibold"><%= order.id %></p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Status</p>
                        <p class="font-semibold capitalize <%= order.status === 'paid' ? 'text-gren-800' : order.status === 'pending' ? 'text-yellow-800' : order.status === 'expired' ? ' text-red-800' : 'bg-gray-100 text-gray-800' %>">
                                <%= order.status === 'paid' ? 'Lunas':
                                    order.status === 'pending' ? 'Menunggu Pembayaran':
                                    order.status === 'expired' ? 'Kadaluarsa':
                                    order.status === 'cancelled' ? 'Dibatalkan': order.status %>
                        </p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Jumlah Tiket</p>
                        <p class="font-semibold"><%= order.quantity %> tiket</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Total</p>
                        <p class="font-semibold text-lg">Rp <%= Number(order.total_amount).toLocaleString('id-ID') %></p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Invoice ID</p>
                        <p class="font-mono text-sm break-all"><%= order.xendit_invoice_id %></p>
                    </div>
                </div>
            </div>

            <!-- Need Help? -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                <h4 class="font-semibold text-blue-900 mb-3">Butuh Bantuan?</h4>
                <ul class="text-sm text-blue-800 space-y-2">
                    <li class="flex items-start">
                        <i class="fas fa-question-circle mr-2 mt-0.5"></i>
                        <span>Hubungi penyelenggara untuk info event</span>
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-exclamation-triangle mr-2 mt-0.5"></i>
                        <span>Laporkan masalah tiket dalam 24 jam</span>
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-phone mr-2 mt-0.5"></i>
                        <span>Customer Service: (021) 1234-5678</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
// Show ticket code in alert
function showTicketCode(ticketCode) {
    const modal = document.createElement('div');
    modal.className = 'fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center z-50';
    modal.innerHTML = `
        <div class="bg-white rounded-lg p-8 max-w-md w-full mx-4">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Kode Tiket Anda</h3>
            <div class="bg-gray-100 p-4 rounded-lg mb-6">
                <p class="text-center font-mono text-2xl font-bold text-gray-800">${ticketCode}</p>
            </div>
            <p class="text-sm text-gray-600 mb-6 text-center">
                Tunjukkan kode ini saat check-in di lokasi event
            </p>
            <div class="flex justify-center space-x-4">
                <button onclick="copyToClipboard('${ticketCode}')" 
                        class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
                    Salin Kode
                </button>
                <button onclick="this.closest('.fixed').remove()" 
                        class="bg-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-400">
                    Tutup
                </button>
            </div>
        </div>
    `;
    document.body.appendChild(modal);
}

// Copy to clipboard
function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(() => {
        alert('Kode tiket berhasil disalin!');
    }).catch(err => {
        console.error('Failed to copy: ', err);
        alert('Gagal menyalin kode tiket');
    });
}

// Print styling
window.addEventListener('beforeprint', () => {
    document.body.classList.add('printing');
});

window.addEventListener('afterprint', () => {
    document.body.classList.remove('printing');
});
</script>

<style>
/* Utility classes */
.line-clamp-3 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
}

@media print {
    .no-print, nav, footer, .sidebar, button, a {
        display: none !important;
    }
    
    body {
        background: white !important;
        font-size: 12pt !important;
    }
    
    .ticket-print {
        page-break-inside: avoid;
        border: 2px solid #000 !important;
        margin-bottom: 20px !important;
    }
    
    .text-gray-900 {
        color: #000 !important;
    }
    
    .text-gray-600 {
        color: #333 !important;
    }
}

/* Modal animation */
.fixed {
    animation: fadeIn 0.3s;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}
</style>

<!-- Footer -->
<%- include('../../partials/footer') %>

</body>
</html>