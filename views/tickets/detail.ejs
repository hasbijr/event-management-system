</head>
<body class="bg-gray-50">
     <nav class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center py-4">
                <div class="flex items-center">
                    <a href="/" class="flex items-center space-x-3">
                        <span class="text-2xl font-bold text-indigo-600">Eventra</span>
                    </a>
                </div>
                
                <div class="hidden md:flex items-center space-x-8">
                    <a href="/" class="text-gray-700 hover:text-indigo-600">Home</a>
                    <a href="/events" class="text-gray-700 hover:text-indigo-600">Events</a>
                    
                    <div class="relative group">
                        <button class="flex items-center text-gray-700 hover:text-indigo-600 space-x-2">
                            <img 
                                src="https://ui-avatars.com/api/?name=User&background=4f46e5&color=ffffff&rounded=true&size=32&bold=true" 
                                alt="User" 
                                class="w-8 h-8 rounded-full border-2 border-indigo-100 shadow-sm"
                            >
                            <span>User Name</span>
                            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>
                        <div class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 hidden group-hover:block z-50 border border-gray-100">
                            <div class="px-4 py-2 flex items-center space-x-2 border-b border-gray-100">
                                <img 
                                    src="https://ui-avatars.com/api/?name=User&background=4f46e5&color=ffffff&rounded=true&size=32&bold=true" 
                                    alt="User" 
                                    class="w-8 h-8 rounded-full"
                                >
                                <div class="text-sm font-medium text-gray-700 truncate">
                                    User Name
                                </div>
                            </div>
                            <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-150">
                                <i class="fas fa-user mr-2 text-indigo-500"></i>Profile
                            </a>
                            <a href="/my-orders" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-150">
                                <i class="fas fa-ticket-alt mr-2 text-indigo-500"></i>Pesanan Saya
                            </a>
                            <a href="/my-events" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-150">
                                <i class="fas fa-calendar-alt mr-2 text-indigo-500"></i>Event Saya
                            </a>
                            <div class="border-t border-gray-100 mt-1 pt-1">
                                <form method="POST" action="/logout" class="w-full">
                                    <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-700 transition-colors duration-150">
                                        <i class="fas fa-sign-out-alt mr-2 text-red-500"></i>Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-600 to-blue-700 text-white p-8 text-center">
            <h1 class="text-3xl font-bold mb-4">E-TICKET</h1>
            <p class="text-blue-100 text-lg">Presentasikan tiket ini saat check-in di lokasi event</p>
        </div>
        
        <div class="p-8">
            <!-- Event Info -->
            <div class="mb-8">
                <div class="flex flex-col md:flex-row items-start md:items-center gap-6 mb-6">
                    <img src="/images/event-placeholder.jpg" 
                         alt="Konser Musik Populer 2024" 
                         class="w-24 h-24 object-cover rounded-lg">
                    
                    <div class="flex-1">
                        <h2 class="text-2xl font-bold text-gray-900 mb-2">Konser Musik Populer 2024</h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                            <div>
                                <p class="text-gray-600">Tanggal & Waktu</p>
                                <p class="font-semibold">
                                    Sabtu, 15 Desember 2024
                                    <br>
                                    19:00
                                </p>
                            </div>
                            <div>
                                <p class="text-gray-600">Lokasi</p>
                                <p class="font-semibold">Gelora Bung Karno</p>
                                <p class="text-gray-600">Jakarta</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Ticket Info -->
            <div class="mb-8">
                <h3 class="text-xl font-semibold text-gray-900 mb-6 border-b pb-3">Detail Tiket</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Left Column -->
                    <div class="space-y-6">
                        <!-- Ticket Code -->
                        <div>
                            <h4 class="text-sm font-semibold text-gray-700 mb-2">Kode Tiket</h4>
                            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                                <p class="text-2xl font-bold text-center font-mono text-gray-800">
                                    TKT-ABC123-XYZ456
                                </p>
                            </div>
                        </div>
                        
                        <!-- QR Code -->
                        <div>
                            <h4 class="text-sm font-semibold text-gray-700 mb-3">QR Code Check-in</h4>
                            <div class="bg-white p-6 border-2 border-gray-300 rounded-lg text-center">
                                <!-- Placeholder for QR Code - in production, generate QR code from ticket code -->
                                <div class="w-48 h-48 mx-auto bg-gray-100 flex items-center justify-center rounded">
                                    <div class="text-center">
                                        <div class="w-32 h-32 bg-gray-300 mx-auto mb-3 flex items-center justify-center rounded">
                                            <div class="grid grid-cols-3 gap-1">
                                                <div class="w-8 h-8 bg-black"></div>
                                                <div class="w-8 h-8 bg-white"></div>
                                                <div class="w-8 h-8 bg-black"></div>
                                                <div class="w-8 h-8 bg-white"></div>
                                                <div class="w-8 h-8 bg-black"></div>
                                                <div class="w-8 h-8 bg-white"></div>
                                                <div class="w-8 h-8 bg-black"></div>
                                                <div class="w-8 h-8 bg-white"></div>
                                                <div class="w-8 h-8 bg-black"></div>
                                            </div>
                                        </div>
                                        <p class="text-xs text-gray-500">QR Code untuk check-in</p>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-500 mt-3">Scan QR code di lokasi event</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Right Column -->
                    <div class="space-y-6">
                        <!-- Attendee Info -->
                        <div>
                            <h4 class="text-sm font-semibold text-gray-700 mb-3">Informasi Attendee</h4>
                            <div class="space-y-4">
                                <div>
                                    <p class="text-sm text-gray-600">Nama</p>
                                    <p class="font-semibold text-lg">Budi Santoso</p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-600">Email</p>
                                    <p class="font-semibold">budi@example.com</p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-600">Telepon</p>
                                    <p class="font-semibold">081234567891</p>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Ticket Status -->
                        <div>
                            <h4 class="text-sm font-semibold text-gray-700 mb-3">Status Tiket</h4>
                            <div class="space-y-2">
                                <div class="flex justify-between">
                                    <span class="text-gray-600">Status Check-in</span>
                                    <span class="font-semibold text-yellow-600">
                                        Belum Check-in
                                    </span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-600">Dibuat</span>
                                    <span class="font-semibold">
                                        15 Desember 2024
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Order Info -->
                        <div>
                            <h4 class="text-sm font-semibold text-gray-700 mb-3">Informasi Pesanan</h4>
                            <div class="space-y-2">
                                <div class="flex justify-between">
                                    <span class="text-gray-600">Order ID</span>
                                    <span class="font-semibold">#ORD-12345</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-600">Status Pesanan</span>
                                    <span class="font-semibold capitalize text-green-600">
                                        Lunas
                                    </span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-600">Total Pembayaran</span>
                                    <span class="font-semibold">
                                        Rp 300.000
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Actions -->
            <div class="border-t border-gray-200 pt-8">
                <div class="flex flex-wrap gap-4">
                    <button onclick="window.print()" 
                            class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 flex items-center">
                        <i class="fas fa-print mr-2"></i> Print Tiket
                    </button>
                    
                    <a href="/orders/1" 
                       class="bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-semibold hover:bg-gray-300 flex items-center">
                        <i class="fas fa-receipt mr-2"></i> Lihat Detail Order
                    </a>
                    
                    <a href="/events/1" 
                       class="bg-green-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-700 flex items-center">
                        <i class="fas fa-calendar-alt mr-2"></i> Lihat Event
                    </a>
                    
                    <button onclick="copyTicketCode('TKT-ABC123-XYZ456')"
                            class="bg-purple-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-purple-700 flex items-center">
                        <i class="fas fa-copy mr-2"></i> Salin Kode Tiket
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Copy ticket code to clipboard
function copyTicketCode(code) {
    navigator.clipboard.writeText(code).then(() => {
        alert('Kode tiket berhasil disalin: ' + code);
    }).catch(err => {
        console.error('Failed to copy: ', err);
        alert('Gagal menyalin kode tiket');
    });
}

// Print styling
window.addEventListener('beforeprint', () => {
    document.body.classList.add('printing');
});

window.addEventListener('afterprint', () => {
    document.body.classList.remove('printing');
});
</script>

<style>
@media print {
    nav, footer, button, a {
        display: none !important;
    }
    
    body {
        background: white !important;
        font-size: 12pt !important;
    }
    
    .bg-gradient-to-r {
        background: linear-gradient(to right, #2563eb, #1d4ed8) !important;
    }
    
    .text-white {
        color: white !important;
    }
}
</style>

